{
  "seed": 42,
  "raw_dir": "data/raw",
  "known": {"Apple": "Apple___healthy", "Corn": "Corn_(maize)___healthy", "Grape": "Grape___healthy", "Peach": "Peach___healthy", "Tomato": "Tomato___healthy"},
  "unknown": {"Potato": "Potato___healthy", "Bell pepper": "Pepper,_bell___healthy"},
  "max_per_known": 250,
  "max_per_unknown": 150,
  "split": {"train": 0.70, "val": 0.15, "test": 0.15},
  "image_size_cnn": 224,
  "image_size_hog": 128,
  "threshold_percentile": 5,
  "mobilenet": {"epochs": 15, "batch_size": 32, "lr": 0.001, "patience": 4, "selection_metric": "val_loss"},
  "svm": {"C": 10.0, "kernel": "rbf", "gamma": "scale"}
}
